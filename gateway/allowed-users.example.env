# Pre-seeded allowlists. Source this file before starting the gateway:
#
#   set -a; source gateway/allowed-users.example.env; set +a
#   hermes gateway start
#
# Each variable is a comma-separated list of platform-specific user IDs.
# Leave a list empty to require pairing for that platform.

# Telegram numeric user IDs (DM @userinfobot for yours).
TELEGRAM_ALLOWED_USER_IDS=

# Discord user IDs (Developer Mode → right-click user → Copy User ID).
DISCORD_ALLOWED_USER_IDS=

# Slack user IDs (workspace member ID, e.g. U07ABCD1234).
SLACK_ALLOWED_USER_IDS=

# WhatsApp E.164 numbers including country code (e.g. +14155551212).
WHATSAPP_ALLOWED_USER_IDS=
